<%
# Definition some utility functions in addition to panruby

if @variant==:html
	@commandstring << " --highlight-style tango"
elsif @variant==:latex
	@commandstring << " --listings --natbib" # Natbib is used for IEEEtran
else
	@commandstring << " --listings"	
end

define_singleton_method(:ref){|ref,text|
 if @variant==:latex then
 "\\autoref{%s}"%[ref]
 else
 "[%s](#%s)"%[text,ref]
 end
}

define_singleton_method(:label){|label|
 if @variant==:latex
 "\\label{%s}" % [label]
 elsif @variant==:html
 "<a id=\"%s\"/>" % [label]
 else
 "{#%s}" % [label]
 end
}

@sections=["sections/introduction.md.erb", "sections/running-example.md.erb", "sections/nature-of-roles.md.erb", "sections/conclusion.md.erb"]
%>


