@MASTERSTHESIS{nupp05,
  author = {Kimmo Nupponen},
  title = { The Design and Implementation of a Graph Rewrite Engine for Model
	Transformations},
  school = {Helsinki University of Technology},
  year = {2005},
  month = may,
  abstract = {Model transformation is used in a wide range of applications including
	program synthesis, refactoring, and reverse engineering. A model
	transformation is a mapping of a set of source models onto a set
	of target models, where the mapping defines correspondences between
	the elements in the source and target models. As mathematical objects,
	models, irrespective of the formalism they are described in, are
	graphs, hypergraphs, or relations, hence model transformation between
	models can be described in terms of graph rewriting (or hypergraph
	or relations rewriting). Graph rewriting provides a rigorous basis
	for specifying the transformation, where subgraphs are replaced with
	other subgraphs according to a set of graph rewrite rules that define
	the transformation. In this thesis, we present the design and implementation
	of a graph rewrite engine for model transformations called cgrk.
	The tool is based on a formal mathematical background that will be
	presented. cgrk facilitates a meta-level framework where the source
	and target models are instances of meta-models. The transformation
	process consists of loading the metamodels and source model into
	an object database, where models are treated as graphs.}
}

