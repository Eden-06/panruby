@INPROCEEDINGS{herrmann02,
  author = {Stephan Herrmann},
  title = {Object Teams: {Improving} Modularity for Crosscutting Collaborations},
  booktitle = {Net.Object Days 2002},
  year = {2002},
  editor = {Mehmet {Ak\c{s}it} and Mira Mezini},
  month = oct,
  abstract = {In this paper, we investigate whether module concepts for capturing
